#!/bin/bash
# uninstall_init —— 卸载应用文件前执行
#
#   1) 停止运行中的服务（此时安装目录还在，直接复用 cmd/main stop）
#   2) 若用户在卸载向导里选择了「删除全部数据」，清理应用数据目录
#
# 向导字段：wizard_data_action（见 wizard/uninstall），取值 keep | purge，
# 默认 keep。向导值由平台以同名环境变量传入；缺失时一律按 keep 处理（保守）。
#
# 审计：所有动作都会 echo（进平台安装日志），并追加写 /tmp/<appname>-uninstall.log。
# 背景：曾出现「用户确认选了清理、@appdata 却在重装后仍有旧数据」且无任何日志可查，
# 因此这里把「环境变量是什么、解析到哪个目录、删了什么、剩了什么」全部留痕。
set -u

APPNAME="${TRIM_APPNAME:-azurlaneautoscript}"
AUDIT_LOG="/tmp/${APPNAME}-uninstall.log"

audit() {
  echo "$1"
  echo "[$(date '+%F %T')] $1" >>"${AUDIT_LOG}" 2>/dev/null || true
}

# $TRIM_PKGVAR 指向 <appdir>/var（软链到 /vol*/@appdata/<appname>）。
# 若环境变量缺失、或目录已被平台移走（软链悬空导致 -d 失败），
# 按 appname 兜底找真实数据目录，避免「选了清理却静默什么都没删」。
resolve_pkgvar() {
  local candidate="${1:-}"
  if [ -n "${candidate}" ] && [ -d "${candidate}" ]; then
    printf '%s' "${candidate}"
    return 0
  fi
  local p
  for p in /vol*/@appdata/"${APPNAME}"; do
    [ -d "${p}" ] && { printf '%s' "${p}"; return 0; }
  done
  return 1
}

# ---- 1) 停服务 -------------------------------------------------------------
CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
if [ -n "${CMD_DIR}" ] && [ -x "${CMD_DIR}/main" ]; then
  "${CMD_DIR}/main" stop >/dev/null 2>&1 || true
fi

# ---- 2) 按向导选择决定是否清理数据 -----------------------------------------
DATA_ACTION="$(printf '%s' "${wizard_data_action:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
case "${DATA_ACTION}" in
  purge|delete|remove|clean|true|1|yes) PURGE=1 ;;
  *) PURGE=0 ;;
esac

PKGVAR="$(resolve_pkgvar "${TRIM_PKGVAR:-}" || true)"

audit "uninstall_init：wizard_data_action=${DATA_ACTION:-（空）} PURGE=${PURGE} TRIM_PKGVAR=${TRIM_PKGVAR:-（空）} 解析到=${PKGVAR:-（未找到）}"

if [ "${PURGE}" -ne 1 ]; then
  audit "保留应用数据（未选择清理）：${PKGVAR:-（未定位）}"
  exit 0
fi

# 拒绝明显异常的路径，避免误删
case "${PKGVAR}" in
  ""|"/"|"/var"|"/usr"|"/vol"|"/vol1"|"/vol2"|"/vol3")
    audit "数据目录路径异常，拒绝清理：${PKGVAR}"
    exit 0
    ;;
esac

if [ -d "${PKGVAR}" ]; then
  # 只清理本应用自己管理的条目，不碰平台可能放置的文件
  rm -rf "${PKGVAR}/config" "${PKGVAR}/log" "${PKGVAR}/alas" 2>/dev/null || true
  rm -f "${PKGVAR}/alas.log" "${PKGVAR}/alas.pid" "${PKGVAR}/console.pid" \
        "${PKGVAR}/console.log" "${PKGVAR}/alas_version.json" 2>/dev/null || true
  for path in "${PKGVAR}"/.alas-prev-* "${PKGVAR}"/.alas-staging-* "${PKGVAR}"/.alas-download*; do
    [ -e "${path}" ] || continue
    rm -rf "${path}" 2>/dev/null || true
  done
  audit "已按卸载选项删除应用数据：${PKGVAR}"
  audit "清理后剩余条目：$(ls -A "${PKGVAR}" 2>/dev/null | tr '\n' ' ')"
else
  audit "数据目录不存在，无需清理：${PKGVAR}"
fi

exit 0
